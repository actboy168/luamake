ninja_required_version = 1.7
builddir = build/msvc
bin = $builddir/bin
obj = $builddir/obj
cc = cl
ml = ml64
luamake = $bin/bootstrap.exe
rule copy
  command = powershell -NonInteractive -Command Copy-Item -Path '$in$input' $
    -Destination '$out' | Out-Null
  description = Copy $in$input $out
  restat = 1
rule c_source_lua
  command = $cc /nologo /showIncludes -c $in /Fo$out /EHsc /Zc:__cplusplus $
    /O2 /Zc:inline /W3 /permissive- /MD /GL /I$builddir/patched/lua55 $
    /Ibee.lua/3rd/lua-patch /D_WIN32_WINNT=0x0602 /DMAKE_LIB $
    /DLUA_BUILD_AS_DLL /DNDEBUG /utf-8 /std:c11
  description = Compile C   $out
  deps = msvc
build $obj/source_lua/onelua.obj: c_source_lua $
    $builddir/patched/lua55/onelua.c | apply_lua_patch
rule cxx_source_bee
  command = $cc /nologo /showIncludes -c $in /Fo$out /EHsc /Zc:__cplusplus $
    /O2 /Zc:inline /W3 /permissive- /MD /GL /I$builddir/patched/lua55 $
    /D_WIN32_WINNT=0x0602 /DNDEBUG /utf-8 /wd4244 /std:c++17 /GR-
  description = Compile C++ $out
  deps = msvc
build $obj/source_bee/lua-seri.obj: cxx_source_bee $
    bee.lua/3rd/lua-seri/lua-seri.cpp | apply_lua_patch
rule cxx_source_bee_1
  command = $cc /nologo /showIncludes -c $in /Fo$out /EHsc /Zc:__cplusplus $
    /O2 /Zc:inline /W3 /permissive- /MD /GL /D_WIN32_WINNT=0x0602 /DNDEBUG $
    /utf-8 /std:c++17 /GR-
  description = Compile C++ $out
  deps = msvc
build $obj/source_bee/format.obj: cxx_source_bee_1 bee.lua/3rd/fmt/format.cc
rule cxx_source_bee_2
  command = $cc /nologo /showIncludes -c $in /Fo$out /EHsc /Zc:__cplusplus $
    /O2 /Zc:inline /W3 /permissive- /MD /GL /Ibee.lua $
    /I$builddir/patched/lua55 /D_WIN32_WINNT=0x0602 /DNDEBUG /utf-8 $
    /std:c++17 /GR-
  description = Compile C++ $out
  deps = msvc
build $obj/source_bee/async.obj: cxx_source_bee_2 $
    bee.lua/bee/async/async.cpp | apply_lua_patch
build $obj/source_bee/async_win.obj: cxx_source_bee_2 $
    bee.lua/bee/async/async_win.cpp | apply_lua_patch
build $obj/source_bee/nanoid.obj: cxx_source_bee_2 $
    bee.lua/bee/crash/nanoid.cpp | apply_lua_patch
build $obj/source_bee/handler_win.obj: cxx_source_bee_2 $
    bee.lua/bee/crash/windows/handler_win.cpp | apply_lua_patch
build $obj/source_bee/stacktrace_win.obj: cxx_source_bee_2 $
    bee.lua/bee/crash/windows/stacktrace_win.cpp | apply_lua_patch
build $obj/source_bee/unwind_win.obj: cxx_source_bee_2 $
    bee.lua/bee/crash/windows/unwind_win.cpp | apply_lua_patch
build $obj/source_bee/filewatch_win.obj: cxx_source_bee_2 $
    bee.lua/bee/filewatch/filewatch_win.cpp | apply_lua_patch
build $obj/source_bee/error.obj: cxx_source_bee_2 bee.lua/bee/lua/error.cpp $
    | apply_lua_patch
build $obj/source_bee/file.obj: cxx_source_bee_2 bee.lua/bee/lua/file.cpp | $
    apply_lua_patch
build $obj/source_bee/luaref.obj: cxx_source_bee_2 $
    bee.lua/bee/lua/luaref.cpp | apply_lua_patch
build $obj/source_bee/bpoll_win.obj: cxx_source_bee_2 $
    bee.lua/bee/net/bpoll_win.cpp | apply_lua_patch
build $obj/source_bee/endpoint.obj: cxx_source_bee_2 $
    bee.lua/bee/net/endpoint.cpp | apply_lua_patch
build $obj/source_bee/event.obj: cxx_source_bee_2 bee.lua/bee/net/event.cpp $
    | apply_lua_patch
build $obj/source_bee/socket.obj: cxx_source_bee_2 $
    bee.lua/bee/net/socket.cpp | apply_lua_patch
build $obj/source_bee/uds_win.obj: cxx_source_bee_2 $
    bee.lua/bee/net/uds_win.cpp | apply_lua_patch
build $obj/source_bee/process_select.obj: cxx_source_bee_2 $
    bee.lua/bee/subprocess/process_select.cpp | apply_lua_patch
build $obj/source_bee/subprocess_win.obj: cxx_source_bee_2 $
    bee.lua/bee/subprocess/subprocess_win.cpp | apply_lua_patch
build $obj/source_bee/file_handle.obj: cxx_source_bee_2 $
    bee.lua/bee/sys/file_handle.cpp | apply_lua_patch
build $obj/source_bee/file_handle_win.obj: cxx_source_bee_2 $
    bee.lua/bee/sys/file_handle_win.cpp | apply_lua_patch
build $obj/source_bee/path_win.obj: cxx_source_bee_2 $
    bee.lua/bee/sys/path_win.cpp | apply_lua_patch
build $obj/source_bee/atomic_sync.obj: cxx_source_bee_2 $
    bee.lua/bee/thread/atomic_sync.cpp | apply_lua_patch
build $obj/source_bee/setname.obj: cxx_source_bee_2 $
    bee.lua/bee/thread/setname.cpp | apply_lua_patch
build $obj/source_bee/simplethread_win.obj: cxx_source_bee_2 $
    bee.lua/bee/thread/simplethread_win.cpp | apply_lua_patch
build $obj/source_bee/spinlock.obj: cxx_source_bee_2 $
    bee.lua/bee/thread/spinlock.cpp | apply_lua_patch
build $obj/source_bee/version.obj: cxx_source_bee_2 bee.lua/bee/version.cpp $
    | apply_lua_patch
build $obj/source_bee/afd.obj: cxx_source_bee_2 bee.lua/bee/win/afd/afd.cpp $
    | apply_lua_patch
build $obj/source_bee/poller.obj: cxx_source_bee_2 $
    bee.lua/bee/win/afd/poller.cpp | apply_lua_patch
build $obj/source_bee/poller_fd.obj: cxx_source_bee_2 $
    bee.lua/bee/win/afd/poller_fd.cpp | apply_lua_patch
build $obj/source_bee/file_holders.obj: cxx_source_bee_2 $
    bee.lua/bee/win/file_holders.cpp | apply_lua_patch
build $obj/source_bee/module_version.obj: cxx_source_bee_2 $
    bee.lua/bee/win/module_version.cpp | apply_lua_patch
build $obj/source_bee/unicode.obj: cxx_source_bee_2 $
    bee.lua/bee/win/unicode.cpp | apply_lua_patch
build $obj/source_bee/wtf8.obj: cxx_source_bee_2 bee.lua/bee/win/wtf8.cpp | $
    apply_lua_patch
rule c_source_bee
  command = $cc /nologo /showIncludes -c $in /Fo$out /EHsc /Zc:__cplusplus $
    /O2 /Zc:inline /W3 /permissive- /MD /GL /Ibee.lua $
    /I$builddir/patched/lua55 /D_WIN32_WINNT=0x0602 /DBEE_STATIC $
    /D_CRT_SECURE_NO_WARNINGS /DNDEBUG /utf-8 /std:c11
  description = Compile C   $out
  deps = msvc
build $obj/source_bee/bee_newstate.obj: c_source_bee $
    bee.lua/3rd/lua-patch/bee_newstate.c | apply_lua_patch
rule cxx_source_bee_3
  command = $cc /nologo /showIncludes -c $in /Fo$out /EHsc /Zc:__cplusplus $
    /O2 /Zc:inline /W3 /permissive- /MD /GL /Ibee.lua $
    /I$builddir/patched/lua55 /D_WIN32_WINNT=0x0602 /DBEE_STATIC $
    /D_CRT_SECURE_NO_WARNINGS /DNDEBUG /utf-8 /std:c++17 /GR-
  description = Compile C++ $out
  deps = msvc
build $obj/source_bee/lua_async.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_async.cpp | apply_lua_patch
build $obj/source_bee/lua_channel.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_channel.cpp | apply_lua_patch
build $obj/source_bee/lua_crash.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_crash.cpp | apply_lua_patch
build $obj/source_bee/lua_debugging.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_debugging.cpp | apply_lua_patch
build $obj/source_bee/lua_epoll.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_epoll.cpp | apply_lua_patch
build $obj/source_bee/lua_filesystem.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_filesystem.cpp | apply_lua_patch
build $obj/source_bee/lua_filewatch.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_filewatch.cpp | apply_lua_patch
build $obj/source_bee/lua_platform.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_platform.cpp | apply_lua_patch
build $obj/source_bee/lua_select.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_select.cpp | apply_lua_patch
build $obj/source_bee/lua_serialization.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_serialization.cpp | apply_lua_patch
build $obj/source_bee/lua_socket.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_socket.cpp | apply_lua_patch
build $obj/source_bee/lua_subprocess.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_subprocess.cpp | apply_lua_patch
build $obj/source_bee/lua_sys.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_sys.cpp | apply_lua_patch
build $obj/source_bee/lua_thread.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_thread.cpp | apply_lua_patch
build $obj/source_bee/lua_time.obj: cxx_source_bee_3 $
    bee.lua/binding/lua_time.cpp | apply_lua_patch
build $obj/source_bee/lua_windows.obj: cxx_source_bee_3 $
    bee.lua/binding/port/lua_windows.cpp | apply_lua_patch
rule cxx_bee_utf8_crt
  command = $cc /nologo /showIncludes -c $in /Fo$out /EHsc /Zc:__cplusplus $
    /O2 /Zc:inline /W3 /permissive- /MD /GL /Ibee.lua /D_WIN32_WINNT=0x0602 $
    /DNDEBUG /utf-8 /std:c++17 /GR-
  description = Compile C++ $out
  deps = msvc
build $obj/bee_utf8_crt/bee_utf8_crt.obj: cxx_bee_utf8_crt $
    bee.lua/3rd/lua-patch/bee_utf8_crt.cpp
build $obj/source_bootstrap/bootstrap_init.obj: cxx_source_bee_2 $
    bee.lua/bootstrap/bootstrap_init.cpp | apply_lua_patch
build $obj/source_bootstrap/main.obj: cxx_source_bee_2 $
    bee.lua/bootstrap/main.cpp | apply_lua_patch
rule rc_bootstrap
  command = rc /nologo /fo $out $in
  description = Compile Res $out
build $obj/bootstrap/bootstrap.obj: rc_bootstrap $
    bee.lua/bootstrap/bootstrap.rc
rule link_bootstrap
  command = $cc /nologo @$out.rsp /link /IMPLIB:$obj/bootstrap.lib $
    advapi32.lib ntdll.lib ws2_32.lib ole32.lib user32.lib version.lib $
    synchronization.lib /DEBUG:NONE /INCREMENTAL:NO /LTCG /out:$out
  description = Link    Exe $out
  rspfile = $out.rsp
  rspfile_content = $in_newline
rule test
  command = $bin/bootstrap.exe bee.lua/test/test.lua --touch $out
  description = Run test.
  pool = console
rule runlua
  command = $luamake $script bee.lua/3rd/lua55 $out luamake.exe
  description = lua $script bee.lua/3rd/lua55 $out luamake.exe
rule c_lua55
  command = $cc /nologo /showIncludes -c $in /Fo$out /EHsc /Zc:__cplusplus $
    /O2 /Zc:inline /W3 /permissive- /MD /GL /DNDEBUG 
  description = Compile C   $out
  deps = msvc
build $obj/lua55/forward_lua.obj: c_lua55 compile/lua/forward_lua.c
rule link_lua55
  command = $cc /nologo @$out.rsp /link /DEBUG:NONE /INCREMENTAL:NO /LTCG $
    /out:$out /DLL /IMPLIB:$implib
  description = Link    Dll $out
  restat = 1
  rspfile = $out.rsp
  rspfile_content = $in_newline
rule lua_embed
  command = $luamake scripts/lua_embed/lua_embed_gen.lua $config $out_c
  description = lua_embed $config
  restat = 1
rule c_luamake_embed
  command = $cc /nologo /showIncludes -c $in /Fo$out /EHsc /Zc:__cplusplus $
    /O2 /Zc:inline /W3 /permissive- /MD /GL $
    /Ibuild/msvc/lua_embed/luamake_embed /Itools/lua55 /DNDEBUG 
  description = Compile C   $out
  deps = msvc
build $obj/luamake_embed/lua_embed.obj: c_luamake_embed $
    build/msvc/lua_embed/luamake_embed/lua_embed.c | $
    __lua_embed_gen_luamake_embed__
build $obj/luamake_embed/bee_glue.obj: c_luamake_embed $
    scripts/lua_embed/bee_glue.c | __lua_embed_gen_luamake_embed__
build $obj/standalone/bootstrap.obj: rc_bootstrap $
    bee.lua/bootstrap/bootstrap.rc | __lua_embed_gen_luamake_embed__
rule cxx_standalone
  command = $cc /nologo /showIncludes -c $in /Fo$out /EHsc /Zc:__cplusplus $
    /O2 /Zc:inline /W3 /permissive- /MD /GL /Ibee.lua/3rd/lua55 /Ibee.lua $
    /Icompile/ninja /Ibuild/msvc/lua_embed/luamake_embed /DNDEBUG $
    /std:c++17 /GR-
  description = Compile C++ $out
  deps = msvc
build $obj/standalone/bootstrap_init.obj: cxx_standalone $
    bee.lua/bootstrap/bootstrap_init.cpp | __lua_embed_gen_luamake_embed__
build $obj/standalone/main.obj: cxx_standalone bee.lua/bootstrap/main.cpp | $
    __lua_embed_gen_luamake_embed__
rule link_standalone
  command = $cc /nologo @$out.rsp /link /IMPLIB:$obj/standalone.lib $
    advapi32.lib ntdll.lib ws2_32.lib ole32.lib user32.lib version.lib $
    synchronization.lib /DEBUG:NONE /INCREMENTAL:NO /LTCG /out:$out
  description = Link    Exe $out
  rspfile = $out.rsp
  rspfile_content = $in_newline
build $builddir/patched/lua55/lapi.c: copy bee.lua/3rd/lua55/lapi.c
build $builddir/patched/lua55/lapi.h: copy bee.lua/3rd/lua55/lapi.h
build $builddir/patched/lua55/lauxlib.c: copy bee.lua/3rd/lua55/lauxlib.c
build $builddir/patched/lua55/lauxlib.h: copy bee.lua/3rd/lua55/lauxlib.h
build $builddir/patched/lua55/lbaselib.c: copy bee.lua/3rd/lua55/lbaselib.c
build $builddir/patched/lua55/lcode.c: copy bee.lua/3rd/lua55/lcode.c
build $builddir/patched/lua55/lcode.h: copy bee.lua/3rd/lua55/lcode.h
build $builddir/patched/lua55/lcorolib.c: copy bee.lua/3rd/lua55/lcorolib.c
build $builddir/patched/lua55/lctype.c: copy bee.lua/3rd/lua55/lctype.c
build $builddir/patched/lua55/lctype.h: copy bee.lua/3rd/lua55/lctype.h
build $builddir/patched/lua55/ldblib.c: copy bee.lua/3rd/lua55/ldblib.c
build $builddir/patched/lua55/ldebug.c: copy bee.lua/3rd/lua55/ldebug.c
build $builddir/patched/lua55/ldebug.h: copy bee.lua/3rd/lua55/ldebug.h
build $builddir/patched/lua55/ldo.c: copy bee.lua/3rd/lua55/ldo.c
build $builddir/patched/lua55/ldo.h: copy bee.lua/3rd/lua55/ldo.h
build $builddir/patched/lua55/ldump.c: copy bee.lua/3rd/lua55/ldump.c
build $builddir/patched/lua55/lfunc.c: copy bee.lua/3rd/lua55/lfunc.c
build $builddir/patched/lua55/lfunc.h: copy bee.lua/3rd/lua55/lfunc.h
build $builddir/patched/lua55/lgc.c: copy bee.lua/3rd/lua55/lgc.c
build $builddir/patched/lua55/lgc.h: copy bee.lua/3rd/lua55/lgc.h
build $builddir/patched/lua55/linit.c: copy bee.lua/3rd/lua55/linit.c
build $builddir/patched/lua55/liolib.c: copy bee.lua/3rd/lua55/liolib.c
build $builddir/patched/lua55/ljumptab.h: copy bee.lua/3rd/lua55/ljumptab.h
build $builddir/patched/lua55/llex.c: copy bee.lua/3rd/lua55/llex.c
build $builddir/patched/lua55/llex.h: copy bee.lua/3rd/lua55/llex.h
build $builddir/patched/lua55/llimits.h: copy bee.lua/3rd/lua55/llimits.h
build $builddir/patched/lua55/lmathlib.c: copy bee.lua/3rd/lua55/lmathlib.c
build $builddir/patched/lua55/lmem.c: copy bee.lua/3rd/lua55/lmem.c
build $builddir/patched/lua55/lmem.h: copy bee.lua/3rd/lua55/lmem.h
build $builddir/patched/lua55/loadlib.c: copy bee.lua/3rd/lua55/loadlib.c
build $builddir/patched/lua55/lobject.c: copy bee.lua/3rd/lua55/lobject.c
build $builddir/patched/lua55/lobject.h: copy bee.lua/3rd/lua55/lobject.h
build $builddir/patched/lua55/lopcodes.c: copy bee.lua/3rd/lua55/lopcodes.c
build $builddir/patched/lua55/lopcodes.h: copy bee.lua/3rd/lua55/lopcodes.h
build $builddir/patched/lua55/lopnames.h: copy bee.lua/3rd/lua55/lopnames.h
build $builddir/patched/lua55/loslib.c: copy bee.lua/3rd/lua55/loslib.c
build $builddir/patched/lua55/lparser.c: copy bee.lua/3rd/lua55/lparser.c
build $builddir/patched/lua55/lparser.h: copy bee.lua/3rd/lua55/lparser.h
build $builddir/patched/lua55/lprefix.h: copy bee.lua/3rd/lua55/lprefix.h
build $builddir/patched/lua55/lstate.c: copy bee.lua/3rd/lua55/lstate.c
build $builddir/patched/lua55/lstate.h: copy bee.lua/3rd/lua55/lstate.h
build $builddir/patched/lua55/lstring.c: copy bee.lua/3rd/lua55/lstring.c
build $builddir/patched/lua55/lstring.h: copy bee.lua/3rd/lua55/lstring.h
build $builddir/patched/lua55/lstrlib.c: copy bee.lua/3rd/lua55/lstrlib.c
build $builddir/patched/lua55/ltable.c: copy bee.lua/3rd/lua55/ltable.c
build $builddir/patched/lua55/ltable.h: copy bee.lua/3rd/lua55/ltable.h
build $builddir/patched/lua55/ltablib.c: copy bee.lua/3rd/lua55/ltablib.c
build $builddir/patched/lua55/ltm.c: copy bee.lua/3rd/lua55/ltm.c
build $builddir/patched/lua55/ltm.h: copy bee.lua/3rd/lua55/ltm.h
build $builddir/patched/lua55/lua.c: copy bee.lua/3rd/lua55/lua.c
build $builddir/patched/lua55/lua.h: copy bee.lua/3rd/lua55/lua.h
build $builddir/patched/lua55/lua.hpp: copy bee.lua/3rd/lua55/lua.hpp
build $builddir/patched/lua55/luac.c: copy bee.lua/3rd/lua55/luac.c
build $builddir/patched/lua55/luaconf.h: copy bee.lua/3rd/lua55/luaconf.h
build $builddir/patched/lua55/lualib.h: copy bee.lua/3rd/lua55/lualib.h
build $builddir/patched/lua55/lundump.c: copy bee.lua/3rd/lua55/lundump.c
build $builddir/patched/lua55/lundump.h: copy bee.lua/3rd/lua55/lundump.h
build $builddir/patched/lua55/lutf8lib.c: copy bee.lua/3rd/lua55/lutf8lib.c
build $builddir/patched/lua55/lvm.c: copy bee.lua/3rd/lua55/lvm.c
build $builddir/patched/lua55/lvm.h: copy bee.lua/3rd/lua55/lvm.h
build $builddir/patched/lua55/lzio.c: copy bee.lua/3rd/lua55/lzio.c
build $builddir/patched/lua55/lzio.h: copy bee.lua/3rd/lua55/lzio.h
build $builddir/patched/lua55/onelua.c: copy bee.lua/3rd/lua55/onelua.c
build $bin/bootstrap.exe: link_bootstrap $obj/bootstrap/bootstrap.obj $
    $obj/source_bee/lua-seri.obj $obj/source_bee/format.obj $
    $obj/source_bee/async.obj $obj/source_bee/async_win.obj $
    $obj/source_bee/nanoid.obj $obj/source_bee/handler_win.obj $
    $obj/source_bee/stacktrace_win.obj $obj/source_bee/unwind_win.obj $
    $obj/source_bee/filewatch_win.obj $obj/source_bee/error.obj $
    $obj/source_bee/file.obj $obj/source_bee/luaref.obj $
    $obj/source_bee/bpoll_win.obj $obj/source_bee/endpoint.obj $
    $obj/source_bee/event.obj $obj/source_bee/socket.obj $
    $obj/source_bee/uds_win.obj $obj/source_bee/process_select.obj $
    $obj/source_bee/subprocess_win.obj $obj/source_bee/file_handle.obj $
    $obj/source_bee/file_handle_win.obj $obj/source_bee/path_win.obj $
    $obj/source_bee/atomic_sync.obj $obj/source_bee/setname.obj $
    $obj/source_bee/simplethread_win.obj $obj/source_bee/spinlock.obj $
    $obj/source_bee/version.obj $obj/source_bee/afd.obj $
    $obj/source_bee/poller.obj $obj/source_bee/poller_fd.obj $
    $obj/source_bee/file_holders.obj $obj/source_bee/module_version.obj $
    $obj/source_bee/unicode.obj $obj/source_bee/wtf8.obj $
    $obj/source_bee/bee_newstate.obj $obj/source_bee/lua_async.obj $
    $obj/source_bee/lua_channel.obj $obj/source_bee/lua_crash.obj $
    $obj/source_bee/lua_debugging.obj $obj/source_bee/lua_epoll.obj $
    $obj/source_bee/lua_filesystem.obj $obj/source_bee/lua_filewatch.obj $
    $obj/source_bee/lua_platform.obj $obj/source_bee/lua_select.obj $
    $obj/source_bee/lua_serialization.obj $obj/source_bee/lua_socket.obj $
    $obj/source_bee/lua_subprocess.obj $obj/source_bee/lua_sys.obj $
    $obj/source_bee/lua_thread.obj $obj/source_bee/lua_time.obj $
    $obj/source_bee/lua_windows.obj $obj/source_lua/onelua.obj $
    $obj/source_bootstrap/bootstrap_init.obj $obj/source_bootstrap/main.obj $
    $obj/bee_utf8_crt/bee_utf8_crt.obj
build $bin/main.lua: copy bee.lua/bootstrap/main.lua
build $obj/test.stamp: test bee.lua/test/glibc-version.lua $
    bee.lua/test/ltest.lua bee.lua/test/shell.lua $
    bee.lua/test/supported.lua bee.lua/test/test.lua $
    bee.lua/test/test_async.lua bee.lua/test/test_channel.lua $
    bee.lua/test/test_epoll.lua bee.lua/test/test_filesystem.lua $
    bee.lua/test/test_filewatch.lua bee.lua/test/test_lua.lua $
    bee.lua/test/test_optional_chain.lua $
    bee.lua/test/test_serialization.lua bee.lua/test/test_skip.lua $
    bee.lua/test/test_socket.lua bee.lua/test/test_subprocess.lua $
    bee.lua/test/test_sys.lua bee.lua/test/test_thread.lua $
    bee.lua/test/test_time.lua bee.lua/test/test_windows.lua | $
    $bin/bootstrap.exe copy_script
build luamake.exe: copy | $bin/bootstrap.exe
  input = $bin/bootstrap.exe
build compile/lua/forward_lua.c: runlua bee.lua/3rd/lua55/lauxlib.h $
    bee.lua/3rd/lua55/lua.h bee.lua/3rd/lua55/lualib.h | copy_luamake $
    compile/lua/forward_lua.lua bootstrap
  script = compile/lua/forward_lua.lua
build $bin/lua55.dll | $obj/lua55/lua55.lib: link_lua55 $
    $obj/lua55/forward_lua.obj
  implib = $obj/lua55/lua55.lib
build tools/lua55.dll: copy | $obj/lua55/lua55.lib $bin/lua55.dll
  input = $bin/lua55.dll
build $builddir/lua_embed/luamake_embed/lua_embed.c $
    $builddir/lua_embed/luamake_embed/lua_embed_data.h: lua_embed $
    build/msvc/lua_embed/luamake_embed/config.lua main.lua $
    scripts/action.lua scripts/arguments.lua scripts/command.lua $
    scripts/command/build.lua scripts/command/clean.lua $
    scripts/command/help.lua scripts/command/init.lua $
    scripts/command/lua.lua scripts/command/rebuild.lua $
    scripts/command/shell.lua scripts/command/test.lua $
    scripts/command/version.lua scripts/compiler/clang.lua $
    scripts/compiler/emcc.lua scripts/compiler/gcc.lua $
    scripts/compiler/gcc_opt.lua scripts/compiler/msvc.lua $
    scripts/compiler/wasi.lua scripts/env/msvc.lua scripts/env/ndk.lua $
    scripts/env/wasi.lua scripts/fsutil.lua scripts/glob.lua $
    scripts/globals.lua scripts/log.lua scripts/lua_def.lua $
    scripts/lua_embed.lua scripts/lua_embed/lua_embed_gen.lua $
    scripts/lua_embed/lua_embed_gen.lua scripts/lua_support.lua $
    scripts/main.lua scripts/ninja_syntax.lua scripts/ninja_writer.lua $
    scripts/os_arch.lua scripts/pathutil.lua scripts/perf.lua $
    scripts/quotearg.lua scripts/sandbox.lua scripts/version.lua $
    scripts/workspace.lua scripts/writer.lua | bootstrap
  config = build/msvc/lua_embed/luamake_embed/config.lua
  out_c = build/msvc/lua_embed/luamake_embed/lua_embed.c
build $bin/standalone.exe: link_standalone $obj/standalone/bootstrap.obj $
    $obj/standalone/bootstrap_init.obj $obj/standalone/main.obj $
    $obj/source_bee/lua-seri.obj $obj/source_bee/format.obj $
    $obj/source_bee/async.obj $obj/source_bee/async_win.obj $
    $obj/source_bee/nanoid.obj $obj/source_bee/handler_win.obj $
    $obj/source_bee/stacktrace_win.obj $obj/source_bee/unwind_win.obj $
    $obj/source_bee/filewatch_win.obj $obj/source_bee/error.obj $
    $obj/source_bee/file.obj $obj/source_bee/luaref.obj $
    $obj/source_bee/bpoll_win.obj $obj/source_bee/endpoint.obj $
    $obj/source_bee/event.obj $obj/source_bee/socket.obj $
    $obj/source_bee/uds_win.obj $obj/source_bee/process_select.obj $
    $obj/source_bee/subprocess_win.obj $obj/source_bee/file_handle.obj $
    $obj/source_bee/file_handle_win.obj $obj/source_bee/path_win.obj $
    $obj/source_bee/atomic_sync.obj $obj/source_bee/setname.obj $
    $obj/source_bee/simplethread_win.obj $obj/source_bee/spinlock.obj $
    $obj/source_bee/version.obj $obj/source_bee/afd.obj $
    $obj/source_bee/poller.obj $obj/source_bee/poller_fd.obj $
    $obj/source_bee/file_holders.obj $obj/source_bee/module_version.obj $
    $obj/source_bee/unicode.obj $obj/source_bee/wtf8.obj $
    $obj/source_bee/bee_newstate.obj $obj/source_bee/lua_async.obj $
    $obj/source_bee/lua_channel.obj $obj/source_bee/lua_crash.obj $
    $obj/source_bee/lua_debugging.obj $obj/source_bee/lua_epoll.obj $
    $obj/source_bee/lua_filesystem.obj $obj/source_bee/lua_filewatch.obj $
    $obj/source_bee/lua_platform.obj $obj/source_bee/lua_select.obj $
    $obj/source_bee/lua_serialization.obj $obj/source_bee/lua_socket.obj $
    $obj/source_bee/lua_subprocess.obj $obj/source_bee/lua_sys.obj $
    $obj/source_bee/lua_thread.obj $obj/source_bee/lua_time.obj $
    $obj/source_bee/lua_windows.obj $obj/source_lua/onelua.obj $
    $obj/luamake_embed/lua_embed.obj $obj/luamake_embed/bee_glue.obj $
    $obj/bee_utf8_crt/bee_utf8_crt.obj
build luamake_lua2c.exe: copy | $bin/standalone.exe
  input = $bin/standalone.exe
build lua_src: phony $builddir/patched/lua55/lapi.c $
    $builddir/patched/lua55/lapi.h $builddir/patched/lua55/lauxlib.c $
    $builddir/patched/lua55/lauxlib.h $builddir/patched/lua55/lbaselib.c $
    $builddir/patched/lua55/lcode.c $builddir/patched/lua55/lcode.h $
    $builddir/patched/lua55/lcorolib.c $builddir/patched/lua55/lctype.c $
    $builddir/patched/lua55/lctype.h $builddir/patched/lua55/ldblib.c $
    $builddir/patched/lua55/ldebug.c $builddir/patched/lua55/ldebug.h $
    $builddir/patched/lua55/ldo.c $builddir/patched/lua55/ldo.h $
    $builddir/patched/lua55/ldump.c $builddir/patched/lua55/lfunc.c $
    $builddir/patched/lua55/lfunc.h $builddir/patched/lua55/lgc.c $
    $builddir/patched/lua55/lgc.h $builddir/patched/lua55/linit.c $
    $builddir/patched/lua55/liolib.c $builddir/patched/lua55/ljumptab.h $
    $builddir/patched/lua55/llex.c $builddir/patched/lua55/llex.h $
    $builddir/patched/lua55/llimits.h $builddir/patched/lua55/lmathlib.c $
    $builddir/patched/lua55/lmem.c $builddir/patched/lua55/lmem.h $
    $builddir/patched/lua55/loadlib.c $builddir/patched/lua55/lobject.c $
    $builddir/patched/lua55/lobject.h $builddir/patched/lua55/lopcodes.c $
    $builddir/patched/lua55/lopcodes.h $builddir/patched/lua55/lopnames.h $
    $builddir/patched/lua55/loslib.c $builddir/patched/lua55/lparser.c $
    $builddir/patched/lua55/lparser.h $builddir/patched/lua55/lprefix.h $
    $builddir/patched/lua55/lstate.c $builddir/patched/lua55/lstate.h $
    $builddir/patched/lua55/lstring.c $builddir/patched/lua55/lstring.h $
    $builddir/patched/lua55/lstrlib.c $builddir/patched/lua55/ltable.c $
    $builddir/patched/lua55/ltable.h $builddir/patched/lua55/ltablib.c $
    $builddir/patched/lua55/ltm.c $builddir/patched/lua55/ltm.h $
    $builddir/patched/lua55/lua.c $builddir/patched/lua55/lua.h $
    $builddir/patched/lua55/lua.hpp $builddir/patched/lua55/luac.c $
    $builddir/patched/lua55/luaconf.h $builddir/patched/lua55/lualib.h $
    $builddir/patched/lua55/lundump.c $builddir/patched/lua55/lundump.h $
    $builddir/patched/lua55/lutf8lib.c $builddir/patched/lua55/lvm.c $
    $builddir/patched/lua55/lvm.h $builddir/patched/lua55/lzio.c $
    $builddir/patched/lua55/lzio.h $builddir/patched/lua55/onelua.c
build apply_lua_patch: phony lua_src
build bootstrap: phony $bin/bootstrap.exe
build copy_script: phony $bin/main.lua
build test: phony $obj/test.stamp
build copy_mainlua: phony $bin/main.lua
build copy_luamake: phony luamake.exe
build forward_lua: phony compile/lua/forward_lua.c
build lua55: phony $bin/lua55.dll
build copy_lua: phony tools/lua55.dll
build notest: phony copy_luamake copy_mainlua copy_lua
build __lua_embed_gen_luamake_embed__: phony $
    $builddir/lua_embed/luamake_embed/lua_embed.c $
    $builddir/lua_embed/luamake_embed/lua_embed_data.h
build standalone: phony $bin/standalone.exe
build copy_standalone: phony luamake_lua2c.exe
build lua2c: phony copy_standalone copy_mainlua copy_lua
default test notest
